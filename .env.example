# =============================================================
# kabu-app 環境変数サンプル
# このファイルを .env.local にコピーして設定してください。
# =============================================================

# データソースの選択:
#   yahoo  : 無料・準リアルタイム・米国株/日本株 両対応(デフォルト・APIキー不要)
#   sample : 同梱のサンプルデータのみ(オフライン/デモ用)
#   vendor : 米国=Finnhub / 日本=J-Quants(各APIキーが必要)
DATA_SOURCE=yahoo

# --- DATA_SOURCE=vendor のときに使用 ---

# 米国株: Finnhub (無料枠 60リクエスト/分) https://finnhub.io/
FINNHUB_API_KEY=

# 日本株: J-Quants (無料枠 12週間遅延/過去2年/5リクエスト毎分)
# https://jpx-jquants.com のマイページで取得するリフレッシュトークン
JQUANTS_REFRESH_TOKEN=
